@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>Catalogue - Brasil Burger</title>

    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #ff8c00, #ff6b35);
            min-height: 100vh;
        }
    </style>
</head>

<body>

<div class="container my-4">

    <!-- NAVBAR -->
    <nav class="navbar bg-white rounded shadow-sm px-3 mb-4">
        <span class="fw-bold text-warning">🍔 Brasil Burger</span>
        <div>
            <a href="/Burger/Index" class="btn btn-warning me-2">Catalogue</a>
            <button class="btn btn-outline-warning me-2">
                Panier <span class="badge bg-danger" id="count">0</span>
            </button>
            <a href="/Home/Index" class="btn btn-danger">Déconnexion</a>
        </div>
    </nav>

    <!-- FILTRES UML -->
    <div class="card mb-4">
        <div class="card-body">
            <strong>Filtrer le catalogue :</strong>
            <div class="mt-2">
                <button class="btn btn-outline-secondary me-2" onclick="filterItems('all')">Tous</button>
                <button class="btn btn-outline-secondary me-2" onclick="filterItems('burger')">Burgers</button>
                <button class="btn btn-outline-secondary me-2" onclick="filterItems('menu')">Menus</button>
                <button class="btn btn-outline-secondary" onclick="filterItems('complement')">Compléments</button>
            </div>
        </div>
    </div>

    <!-- CATALOGUE -->
    <div class="row g-4" id="catalogue">

        <!-- BURGERS -->
        <div class="col-md-4 item burger">
            <div class="card h-100">
                <div class="card-body">
                    <h5>Classic Burger</h5>
                    <p class="fw-bold text-warning">2500 FCFA</p>
                    <button class="btn btn-warning w-100" onclick="addToCart()">Ajouter</button>
                </div>
            </div>
        </div>

        <div class="col-md-4 item burger">
            <div class="card h-100">
                <div class="card-body">
                    <h5>Cheese Burger</h5>
                    <p class="fw-bold text-warning">3000 FCFA</p>
                    <button class="btn btn-warning w-100" onclick="addToCart()">Ajouter</button>
                </div>
            </div>
        </div>

        <!-- MENUS -->
        <div class="col-md-4 item menu">
            <div class="card h-100">
                <div class="card-body">
                    <h5>Menu Burger</h5>
                    <p class="fw-bold text-warning">4500 FCFA</p>
                    <button class="btn btn-warning w-100" onclick="addToCart()">Ajouter</button>
                </div>
            </div>
        </div>

        <!-- COMPLEMENTS -->
        <div class="col-md-4 item complement">
            <div class="card h-100">
                <div class="card-body">
                    <h5>Frites</h5>
                    <p class="fw-bold text-warning">1000 FCFA</p>
                    <button class="btn btn-warning w-100" onclick="addToCart()">Ajouter</button>
                </div>
            </div>
        </div>

        <div class="col-md-4 item complement">
            <div class="card h-100">
                <div class="card-body">
                    <h5>Boisson</h5>
                    <p class="fw-bold text-warning">800 FCFA</p>
                    <button class="btn btn-warning w-100" onclick="addToCart()">Ajouter</button>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    let count = 0;

    function addToCart() {
        count++;
        document.getElementById("count").textContent = count;
    }

    function filterItems(type) {
        document.querySelectorAll(".item").forEach(el => {
            if (type === "all") {
                el.style.display = "block";
            } else {
                el.style.display = el.classList.contains(type) ? "block" : "none";
            }
        });
    }
</script>

</body>
</html>
