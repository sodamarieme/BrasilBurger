@model BrasilBurgerC.Models.Burger
@{
    ViewData["Title"] = "Détails du Burger";
    var complements = ViewBag.Complements as List<BrasilBurgerC.Models.Complement> ?? new List<BrasilBurgerC.Models.Complement>();
}

<link rel="stylesheet" href="~/css/burger.css" />

<nav class="navbar" style="background:white; padding:15px 25px; border-radius:15px; margin-bottom:30px; display:flex; justify-content:space-between; align-items:center;">
    <div class="logo" style="font-size:1.5em; font-weight:bold; color:#ff6b35;">🍔 Brasil Burger</div>
    <div style="display:flex; gap:10px;">
        <a href="/Produit" class="nav-btn" style="background:#ff6b35; color:white; padding:10px 20px; border-radius:8px; text-decoration:none;">Catalogue</a>
        <a href="/Panier" class="nav-btn" style="background:#ff6b35; color:white; padding:10px 20px; border-radius:8px; text-decoration:none;">Panier</a>
        <a href="/Commande" class="nav-btn" style="background:#ff6b35; color:white; padding:10px 20px; border-radius:8px; text-decoration:none;">Commandes</a>
        <a href="/Auth/Logout" class="nav-btn" style="background:#e74c3c; color:white; padding:10px 20px; border-radius:8px; text-decoration:none;">Déconnexion</a>
    </div>
</nav>

<div class="container" style="max-width:900px; margin:0 auto; padding:20px;">
    <div style="background:white; border-radius:15px; padding:30px; border-left:5px solid #ff6b35;">
        <div style="display:flex; gap:30px; flex-wrap:wrap;">
            <div style="flex:1; min-width:300px;">
            <img src="/images/burger.jpg" class="produit-img" style="width:100%; height:200px; object-fit:cover;">
            </div>
            <div style="flex:1; min-width:300px;">
                <h2 style="color:#333; margin-bottom:15px;">@Model.Nom</h2>
                <p style="color:#ff6b35; font-size:1.5em; font-weight:bold; margin-bottom:20px;">@Model.Prix FCFA</p>
                
                <button onclick="ajouterAuPanier('Burger', @Model.Id, '@Model.Nom', @Model.Prix)" class="btn-orange" style="background:#ff6b35; color:white; padding:15px 30px; border-radius:8px; border:none; cursor:pointer; font-size:1.1em; margin-bottom:20px;">
                    Ajouter au panier
                </button>

                @if (complements.Count > 0)
                {
                    <h3 style="margin-top:30px; margin-bottom:15px;">Compléments disponibles</h3>
                    <div style="display:flex; flex-direction:column; gap:10px;">
                        @foreach (var complement in complements)
                        {
                            <div style="display:flex; justify-content:space-between; align-items:center; padding:10px; background:#f9f9f9; border-radius:8px;">
                                <div>
                                    <strong>@complement.Nom</strong>
                                    <p style="margin:0; color:#666; font-size:0.9em;">@complement.Prix FCFA</p>
                                </div>
                                <button onclick="ajouterAuPanier('Complement', @complement.Id, '@complement.Nom', @complement.Prix)" class="btn-orange" style="background:#ff6b35; color:white; padding:8px 15px; border-radius:5px; border:none; cursor:pointer;">
                                    Ajouter
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
function ajouterAuPanier(type, id, nom, prix) {
    let burgerId = null, menuId = null, complementId = null;
    
    if (type === 'Burger') burgerId = id;
    else if (type === 'Menu') menuId = id;
    else if (type === 'Complement') complementId = id;

    fetch('/Panier/Ajouter', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: `type=${type}&burgerId=${burgerId || ''}&menuId=${menuId || ''}&complementId=${complementId || ''}`
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Ajouté au panier !');
        }
    })
    .catch(error => console.error('Error:', error));
}
</script>

