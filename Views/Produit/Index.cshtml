@model List<BrasilBurgerC.Models.Produit>

@{
    ViewData["Title"] = "Catalogue";
}

<div class="container mt-4">
    <h2 class="text-white mb-4">🍔 Catalogue</h2>

    <!-- FILTRES UML -->
    <div class="mb-4">
        <a class="btn btn-light me-2" href="/Produit/Index">Tous</a>
        <a class="btn btn-light me-2" href="/Produit/Index?type=Burger">Burgers</a>
        <a class="btn btn-light me-2" href="/Produit/Index?type=Menu">Menus</a>
        <a class="btn btn-light" href="/Produit/Index?type=Complement">Compléments</a>
    </div>

    <div class="row">
        @foreach (var p in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow">
                    <div class="card-body">
                        <h5 class="card-title">@p.Nom</h5>
                        <p class="card-text">
                            <strong>@p.Type</strong><br />
                            <span class="text-warning fw-bold">@p.Prix FCFA</span>
                        </p>
                        <button class="btn btn-warning w-100">
                            Ajouter au panier
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
