@{
    ViewData["Title"] = "Catalogue";
    Layout = null;
    var burgers = ViewBag.Burgers as List<BrasilBurgerC.Models.Burger> ?? new List<BrasilBurgerC.Models.Burger>();
    var type = ViewBag.Type as string ?? "all";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Catalogue - BurgerShop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #ff8c42 0%, #ff6b35 100%);
            min-height: 100vh;
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .navbar-custom {
            background: white;
            border-radius: 15px;
            padding: 15px 30px;
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .navbar-logo {
            font-size: 1.5em;
            font-weight: bold;
            color: #ff6b35;
        }

        .navbar-buttons {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .btn-nav {
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-nav-orange {
            background: #ff6b35;
            color: white;
        }

        .btn-nav-orange:hover {
            background: #e55a2b;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .btn-nav-red {
            background: #e74c3c;
            color: white;
        }

        .btn-nav-red:hover {
            background: #c0392b;
            color: white;
        }

        .container-custom {
            max-width: 1400px;
            margin: 0 auto;
        }

        .filter-section {
            background: white;
            border-radius: 15px;
            padding: 20px 30px;
            margin-bottom: 30px;
            display: flex;
            gap: 15px;
            align-items: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .filter-label {
            color: #333;
            font-weight: 600;
            white-space: nowrap;
        }

        .filter-btn {
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            border: 2px solid #ddd;
            background: white;
            color: #666;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .filter-btn:hover {
            border-color: #ff6b35;
            color: #ff6b35;
        }

        .filter-btn.active {
            background: #ff6b35;
            color: white;
            border-color: #ff6b35;
        }

        .section-title {
            background: white;
            border-radius: 15px;
            padding: 20px 30px;
            margin-bottom: 20px;
            font-size: 1.8em;
            font-weight: bold;
            color: #333;
            border-bottom: 3px solid #ff6b35;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }

        .product-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            transition: all 0.3s;
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

        .product-image {
            width: 100%;
            height: 250px;
            object-fit: cover;
            background: #f5f5f5;
        }

        .product-info {
            padding: 25px;
        }

        .product-name {
            font-size: 1.3em;
            font-weight: bold;
            color: #333;
            margin-bottom: 10px;
        }

        .product-description {
            color: #666;
            font-size: 0.95em;
            margin-bottom: 15px;
            line-height: 1.5;
        }

        .product-price {
            font-size: 1.5em;
            font-weight: bold;
            color: #ff6b35;
            margin-bottom: 15px;
        }

        .btn-add {
            width: 100%;
            padding: 12px;
            background: #ff6b35;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 1em;
        }

        .btn-add:hover {
            background: #e55a2b;
            transform: scale(1.05);
        }

        .empty-message {
            text-align: center;
            color: white;
            font-size: 1.2em;
            padding: 40px;
        }
    </style>
</head>
<body>
    <div class="container-custom">
        <!-- NAVBAR -->
        <div class="navbar-custom">
            <div class="navbar-logo">🍔 BurgerShop</div>
            <div class="navbar-buttons">
                <a href="/Produit" class="btn-nav btn-nav-orange"> Catalogue</a>
                <a href="/Panier" class="btn-nav btn-nav-orange"> Panier <span id="cartCount">(0)</span></a>
                <a href="/Commande" class="btn-nav btn-nav-orange"> Commandes</a>
                <a href="/Auth/Logout" class="btn-nav btn-nav-red">Déconnexion</a>
            </div>
        </div>

        <!-- FILTRES -->
        <div class="filter-section">
            <span class="filter-label">Filtrer par:</span>
            <a href="/Produit" class="filter-btn @(type == "all" ? "active" : "")">Tous</a>
            <a href="/Produit?type=Burger" class="filter-btn @(type == "Burger" ? "active" : "")">Par Burger</a>
            <a href="/Produit?type=Menu" class="filter-btn @(type == "Menu" ? "active" : "")">Par Menu</a>
            <a href="/Produit?type=Complement" class="filter-btn @(type == "Complement" ? "active" : "")">Compléments</a>
        </div>

        <!-- TITRE SECTION -->
        <div class="section-title">
            @if (type == "Menu")
            {
                <span> Nos Menus</span>
            }
            else if (type == "Complement")
            {
                <span> Compléments</span>
            }
            else
            {
                <span> Nos Burgers</span>
            }
        </div>

        <!-- GRILLE PRODUITS -->
        @if (burgers.Any() || (ViewBag.Complements as List<BrasilBurgerC.Models.Complement>).Count > 0 || (ViewBag.Menus as List<BrasilBurgerC.Models.Menu>).Count > 0)
        {
            <div class="products-grid">
                @{
                    var images = new[] {
                        "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=500&h=500&fit=crop",
                        "https://images.unsplash.com/photo-1550547660-d9450f859349?w=500&h=500&fit=crop",
                        "https://images.unsplash.com/photo-1585238341710-4b5eb7f2edcd?w=500&h=500&fit=crop",
                        "https://images.unsplash.com/photo-1553979459-d2229ba7433b?w=500&h=500&fit=crop"
                        
                    };
                    var menuImages = new[] {
                        "https://images.unsplash.com/photo-1613374534578-48a6f900bb60?w=500&h=500&fit=crop",
                        "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500&h=500&fit=crop",
                        "https://images.unsplash.com/photo-1562547256-ee4ac7c8e4fe?w=500&h=500&fit=crop",
                        "https://images.unsplash.com/photo-1607623814075-e51df1bdc82f?w=500&h=500&fit=crop"
                    };
                    var complementImages = new[] {
                        "https://images.unsplash.com/photo-1585238341710-4b5eb7f2edcd?w=500&h=500&fit=crop",
                        "https://images.unsplash.com/photo-1571115177098-24ec42ed204d?w=500&h=500&fit=crop",
                        "https://images.unsplash.com/photo-1512621776951-a57141f2eefd?w=500&h=500&fit=crop",
                        "https://images.unsplash.com/photo-1596040694230-a60ba2d3f67b?w=500&h=500&fit=crop"
                    };
                }

                @if (type == "all" || type == "Burger")
                {
                    @foreach (var burger in burgers)
                    {
                        <div class="product-card">
                            <img src="@images[burger.Id - 1]" alt="@burger.Nom" class="product-image">
                            <div class="product-info">
                                <h3 class="product-name">@burger.Nom</h3>
                                <p class="product-description">Délicieux burger @burger.Nom.ToLower() avec tous les garnitures premium</p>
                                <div class="product-price">@burger.Prix FCFA</div>
                                <button class="btn-add" onclick="ajouterAuPanier(@burger.Id, '@burger.Nom', @burger.Prix)">Ajouter</button>
                            </div>
                        </div>
                    }
                }

                @if (type == "all" || type == "Menu")
                {
                    @foreach (var menu in (ViewBag.Menus as List<BrasilBurgerC.Models.Menu>))
                    {
                        <div class="product-card">
                            <img src="@menuImages[menu.Id - 1]" alt="@menu.Nom" class="product-image">
                            <div class="product-info">
                                <h3 class="product-name">@menu.Nom</h3>
                                <p class="product-description">@menu.Description</p>
                                <div class="product-price">@menu.Prix FCFA</div>
                                <button class="btn-add" onclick="ajouterAuPanier(@menu.Id, '@menu.Nom', @menu.Prix, 'Menu')">Ajouter</button>
                            </div>
                        </div>
                    }
                }

                @if (type == "all" || type == "Complement")
                {
                    @foreach (var complement in (ViewBag.Complements as List<BrasilBurgerC.Models.Complement>))
                    {
                        <div class="product-card">
                            <img src="@complementImages[complement.Id - 1]" alt="@complement.Nom" class="product-image">
                            <div class="product-info">
                                <h3 class="product-name">@complement.Nom</h3>
                                <p class="product-description">@complement.Nom avec les meilleures saveurs</p>
                                <div class="product-price">@complement.Prix FCFA</div>
                                <button class="btn-add" onclick="ajouterAuPanier(@complement.Id, '@complement.Nom', @complement.Prix, 'Complement')">Ajouter</button>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="empty-message">
                Aucun produit disponible pour le moment
            </div>
        }
    </div>

    <script>
        function ajouterAuPanier(productId, nom, prix, type = 'Burger') {
            const params = new URLSearchParams();
            params.append('type', type);
            
            if (type === 'Burger') {
                params.append('burgerId', productId);
            } else if (type === 'Menu') {
                params.append('menuId', productId);
            } else if (type === 'Complement') {
                params.append('complementId', productId);
            }
            
            fetch('/Panier/Ajouter', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: params.toString()
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('cartCount').textContent = `(${data.count})`;
                    alert(`${nom} ajouté au panier !`);
                }
            })
            .catch(error => console.error('Error:', error));
        }
    </script>
</body>
</html>
