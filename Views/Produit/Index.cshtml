@model List<BrasilBurgerC.Models.Produit>

@{
    ViewData["Title"] = "Catalogue";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>Catalogue</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #ff8c00, #ff6b35);
            min-height: 100vh;
        }
    </style>
</head>
<body>

<div class="container my-4">

    <h2 class="text-white mb-3">🍔 Catalogue</h2>

    <!-- FILTRES -->
    <div class="mb-4">
        <button class="btn btn-light me-2" onclick="filter('Tous')">Tous</button>
        <button class="btn btn-light me-2" onclick="filter('Burger')">Burgers</button>
        <button class="btn btn-light me-2" onclick="filter('Menu')">Menus</button>
        <button class="btn btn-light" onclick="filter('Complement')">Compléments</button>
    </div>

    <!-- PRODUITS -->
    <div class="row" id="catalogue">
        @foreach (var p in Model)
        {
            <div class="col-md-4 mb-4 produit @p.Type">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@p.Nom</h5>
                        <p class="fw-bold text-warning">@p.Prix FCFA</p>
                        <span class="badge bg-secondary">@p.Type</span>

                        <button class="btn btn-warning w-100 mt-2">
                            Ajouter au panier
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

</div>

<script>
function filter(type) {
    document.querySelectorAll(".produit").forEach(p => {
        if (type === "Tous" || p.classList.contains(type)) {
            p.style.display = "block";
        } else {
            p.style.display = "none";
        }
    });
}
</script>

</body>
</html>
