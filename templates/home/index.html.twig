{% extends 'base.html.twig' %}

{% block title %}Accueil - Brasil Burger{% endblock %}

{% block body %}
<div class="container">
    <!-- Hero Section -->
    <section class="hero">
        <h1>🍔 Bienvenue chez Brasil Burger</h1>
        <p>Les meilleurs burgers brésiliens de la ville. Saveurs authentiques, ingrédients frais, livraison rapide !</p>
        <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
            <a href="{{ path('app_menu') }}" class="btn btn-lg">🍔 Voir le Menu</a>
            <a href="#featured" class="btn btn-outline btn-lg">⭐ Nos Spécialités</a>
        </div>
    </section>

    <!-- Stats Section -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">🥬</div>
            <div class="stat-value">100%</div>
            <div class="stat-label">Ingrédients Frais</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">🚚</div>
            <div class="stat-value">30 min</div>
            <div class="stat-label">Livraison Rapide</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">❤️</div>
            <div class="stat-value">5000+</div>
            <div class="stat-label">Clients Satisfaits</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">⭐</div>
            <div class="stat-value">4.9/5</div>
            <div class="stat-label">Note Moyenne</div>
        </div>
    </div>

    <!-- Featured Burgers -->
    <section class="section" id="featured">
        <h2 class="section-title">🍔 Nos Burgers Populaires</h2>
        
        {% if burgers|length > 0 %}
        <div class="products-grid">
            {% for burger in burgers %}
            <div class="product-card">
                <img src="{{ burger.image ?? 'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=400' }}" alt="{{ burger.nom }}">
                <div class="product-info">
                    <h3 class="product-name">{{ burger.nom }}</h3>
                    <p class="product-desc">{{ burger.description|length > 80 ? burger.description|slice(0, 80) ~ '...' : burger.description }}</p>
                    <div class="product-price">{{ burger.prix|number_format(0, ',', ' ') }} FCFA</div>
                    <div class="product-actions">
                        <a href="{{ path('app_menu_burger', {id: burger.id}) }}" class="btn-edit">👁️ Détails</a>
                        <button class="btn-valider" onclick="addToCart('burger', {{ burger.id }}, '{{ burger.nom|e('js') }}', {{ burger.prix }}, '{{ burger.image|e('js') }}')">
                            🛒 Ajouter
                        </button>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="empty-state">
            <div class="icon">🍔</div>
            <h3>Aucun burger disponible</h3>
            <p>Nos burgers arrivent bientôt !</p>
        </div>
        {% endif %}
        
        <div class="text-center mt-2">
            <a href="{{ path('app_menu') }}" class="btn">Voir tous les burgers →</a>
        </div>
    </section>

    <!-- Featured Menus -->
    {% if menus|length > 0 %}
    <section class="section">
        <h2 class="section-title">🎁 Nos Menus</h2>
        
        <div class="products-grid">
            {% for menu in menus %}
            <div class="product-card">
                <img src="{{ menu.image ?? 'https://images.unsplash.com/photo-1594212699903-ec8a3eca50f5?w=400' }}" alt="{{ menu.nom }}">
                <div class="product-info">
                    <h3 class="product-name">{{ menu.nom }}</h3>
                    <p class="product-desc">{{ menu.description|length > 80 ? menu.description|slice(0, 80) ~ '...' : menu.description }}</p>
                    <div class="product-price">{{ menu.prix|number_format(0, ',', ' ') }} FCFA</div>
                    <div class="product-actions">
                        <a href="{{ path('app_menu_formule', {id: menu.id}) }}" class="btn-edit">👁️ Détails</a>
                        <button class="btn-valider" onclick="addToCart('menu', {{ menu.id }}, '{{ menu.nom|e('js') }}', {{ menu.prix }}, '{{ menu.image|e('js') }}')">
                            🛒 Ajouter
                        </button>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}
</div>
{% endblock %}

{% block javascripts_bottom %}
<script>
function addToCart(type, id, name, price, image) {
    let cart = JSON.parse(localStorage.getItem('cart') || '[]');
    
    const existingIndex = cart.findIndex(item => item.type === type && item.id === id);
    
    if (existingIndex > -1) {
        cart[existingIndex].quantity += 1;
    } else {
        cart.push({
            type: type,
            id: id,
            name: name,
            price: price,
            image: image,
            quantity: 1
        });
    }
    
    localStorage.setItem('cart', JSON.stringify(cart));
    updateCartCount();
    
    alert('✅ ' + name + ' ajouté au panier !');
}
</script>
{% endblock %}
