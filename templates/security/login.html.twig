<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion - Brasil Burger</title>
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            display: flex;
            background: linear-gradient(135deg, #ff8c00 0%, #ff6b35 50%, #ff5722 100%);
        }
        
        .login-container {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }
        
        .login-left {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px;
            color: white;
            text-align: center;
        }
        
        .brand-logo {
            font-size: 5rem;
            margin-bottom: 20px;
            animation: bounce 2s ease-in-out infinite;
        }
        
        .brand-logo img {
            width: 100px;
            height: 100px;
        }
        
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }
        
        .brand-name {
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 15px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }
        
        .brand-tagline {
            font-size: 1.3rem;
            opacity: 0.95;
            max-width: 400px;
        }
        
        .burger-images {
            display: flex;
            gap: 20px;
            margin-top: 50px;
            flex-wrap: wrap;
            justify-content: center;
        }
        
        .burger-img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid rgba(255,255,255,0.3);
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            transition: transform 0.3s ease;
        }
        
        .burger-img:hover {
            transform: scale(1.1) rotate(5deg);
        }
        
        .login-right {
            width: 500px;
            background: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 60px;
            box-shadow: -10px 0 40px rgba(0,0,0,0.1);
        }
        
        .login-header {
            margin-bottom: 40px;
        }
        
        .login-header h1 {
            font-size: 2rem;
            font-weight: 700;
            color: #333;
            margin-bottom: 10px;
        }
        
        .login-header p {
            color: #888;
        }
        
        .form-group {
            margin-bottom: 25px;
        }
        
        .form-group label {
            display: block;
            font-weight: 600;
            color: #333;
            margin-bottom: 10px;
            font-size: 0.95rem;
        }
        
        .form-control {
            width: 100%;
            padding: 16px 20px;
            border: 2px solid #eee;
            border-radius: 12px;
            font-size: 1rem;
            font-family: inherit;
            transition: all 0.3s ease;
            background: #fafafa;
        }
        
        .form-control:focus {
            outline: none;
            border-color: #ff8c00;
            background: white;
            box-shadow: 0 0 0 4px rgba(255,140,0,0.1);
        }
        
        .remember-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        
        .remember-label {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            color: #666;
        }
        
        .remember-label input {
            width: 18px;
            height: 18px;
            accent-color: #ff8c00;
        }
        
        .btn-login {
            width: 100%;
            padding: 18px;
            background: linear-gradient(135deg, #ff8c00, #ff6b35);
            border: none;
            border-radius: 12px;
            color: white;
            font-size: 1.1rem;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 8px 25px rgba(255,140,0,0.3);
        }
        
        .btn-login:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(255,140,0,0.4);
        }
        
        .divider {
            text-align: center;
            margin: 35px 0;
            position: relative;
        }
        
        .divider::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            width: 100%;
            height: 1px;
            background: #eee;
        }
        
        .divider span {
            background: white;
            padding: 0 20px;
            position: relative;
            color: #888;
        }
        
        .register-link {
            text-align: center;
        }
        
        .register-link a {
            display: inline-block;
            padding: 15px 40px;
            border: 2px solid #ff8c00;
            border-radius: 12px;
            color: #ff8c00;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .register-link a:hover {
            background: #ff8c00;
            color: white;
        }
        
        .error-message {
            background: #fff5f5;
            color: #c53030;
            padding: 15px 20px;
            border-radius: 12px;
            margin-bottom: 25px;
            border-left: 4px solid #c53030;
        }
        
        @media (max-width: 900px) {
            .login-left { display: none; }
            .login-right { width: 100%; padding: 40px 30px; }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-left">
            <div class="brand-logo">
                <img src="{{ asset('images/logo.png') }}" alt="Brasil Burger" onerror="this.style.display='none'">
            </div>
            <h1 class="brand-name">Brasil Burger</h1>
            <p class="brand-tagline">Les meilleurs burgers artisanaux, prepares avec passion et livres chez vous !</p>
            
            <div class="burger-images">
                <img src="{{ asset('images/burgers/classic-burger.jpg') }}" alt="Classic Burger" class="burger-img">
                <img src="{{ asset('images/burgers/cheese-burger.jpg') }}" alt="Cheese Burger" class="burger-img">
                <img src="{{ asset('images/burgers/bacon-burger.jpg') }}" alt="Bacon Burger" class="burger-img">
            </div>
        </div>
        
        <div class="login-right">
            <div class="login-header">
                <h1>Bienvenue !</h1>
                <p>Connectez-vous pour acceder a votre compte</p>
            </div>
            
            {% if error %}
            <div class="error-message">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
            {% endif %}
            
            <form method="post">
                <div class="form-group">
                    <label>Adresse email</label>
                    <input type="email" name="_username" class="form-control" value="{{ last_username }}" required autofocus placeholder="exemple@email.com">
                </div>
                
                <div class="form-group">
                    <label>Mot de passe</label>
                    <input type="password" name="_password" class="form-control" required placeholder="Votre mot de passe">
                </div>
                
                <div class="remember-row">
                    <label class="remember-label">
                        <input type="checkbox" name="_remember_me">
                        <span>Se souvenir de moi</span>
                    </label>
                </div>
                
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                
                <button type="submit" class="btn-login">Se connecter</button>
            </form>
            
            <div class="divider">
                <span>ou</span>
            </div>
            
            <div class="register-link">
                <a href="{{ path('app_register') }}">Creer un nouveau compte</a>
            </div>
        </div>
    </div>
</body>
</html>

