<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscription - Brasil Burger</title>
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            display: flex;
            background: linear-gradient(135deg, #ff8c00 0%, #ff6b35 50%, #ff5722 100%);
        }
        
        .register-container {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }
        
        .register-left {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px;
            color: white;
            text-align: center;
        }
        
        .brand-logo {
            font-size: 5rem;
            margin-bottom: 20px;
            animation: bounce 2s ease-in-out infinite;
        }
        
        .brand-logo img {
            width: 100px;
            height: 100px;
        }
        
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }
        
        .brand-name {
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 15px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }
        
        .brand-tagline {
            font-size: 1.3rem;
            opacity: 0.95;
            max-width: 400px;
        }
        
        .burger-images {
            display: flex;
            gap: 20px;
            margin-top: 50px;
            flex-wrap: wrap;
            justify-content: center;
        }
        
        .burger-img {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid rgba(255,255,255,0.3);
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            transition: transform 0.3s ease;
        }
        
        .burger-img:hover {
            transform: scale(1.1) rotate(5deg);
        }
        
        .register-right {
            width: 550px;
            background: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 50px;
            box-shadow: -10px 0 40px rgba(0,0,0,0.1);
            overflow-y: auto;
        }
        
        .register-header {
            margin-bottom: 30px;
        }
        
        .register-header h1 {
            font-size: 1.8rem;
            font-weight: 700;
            color: #333;
            margin-bottom: 10px;
        }
        
        .register-header p {
            color: #888;
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-group label {
            display: block;
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
            font-size: 0.9rem;
        }
        
        .form-control {
            width: 100%;
            padding: 14px 18px;
            border: 2px solid #eee;
            border-radius: 12px;
            font-size: 1rem;
            font-family: inherit;
            transition: all 0.3s ease;
            background: #fafafa;
        }
        
        .form-control:focus {
            outline: none;
            border-color: #ff8c00;
            background: white;
            box-shadow: 0 0 0 4px rgba(255,140,0,0.1);
        }
        
        .btn-register {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #ff8c00, #ff6b35);
            border: none;
            border-radius: 12px;
            color: white;
            font-size: 1.1rem;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 8px 25px rgba(255,140,0,0.3);
            margin-top: 10px;
        }
        
        .btn-register:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(255,140,0,0.4);
        }
        
        .divider {
            text-align: center;
            margin: 25px 0;
            position: relative;
        }
        
        .divider::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            width: 100%;
            height: 1px;
            background: #eee;
        }
        
        .divider span {
            background: white;
            padding: 0 20px;
            position: relative;
            color: #888;
        }
        
        .login-link {
            text-align: center;
        }
        
        .login-link a {
            display: inline-block;
            padding: 14px 35px;
            border: 2px solid #ff8c00;
            border-radius: 12px;
            color: #ff8c00;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .login-link a:hover {
            background: #ff8c00;
            color: white;
        }
        
        .flash-messages {
            margin-bottom: 20px;
        }
        
        .alert {
            padding: 12px 18px;
            border-radius: 10px;
            margin-bottom: 10px;
            font-size: 0.9rem;
        }
        
        .alert-error {
            background: #fff5f5;
            color: #c53030;
            border-left: 4px solid #c53030;
        }
        
        .alert-success {
            background: #f0fff4;
            color: #22543d;
            border-left: 4px solid #38a169;
        }
        
        @media (max-width: 900px) {
            .register-left { display: none; }
            .register-right { width: 100%; padding: 30px 25px; }
            .form-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="register-left">
            <div class="brand-logo">
                <img src="{{ asset('images/logo.png') }}" alt="Brasil Burger" onerror="this.style.display='none'">
            </div>
            <h1 class="brand-name">Brasil Burger</h1>
            <p class="brand-tagline">Rejoignez notre communaute de gourmands et profitez de nos delicieux burgers !</p>
            
            <div class="burger-images">
                <img src="{{ asset('images/burgers/classic-burger.jpg') }}" alt="Classic Burger" class="burger-img">
                <img src="{{ asset('images/burgers/cheese-burger.jpg') }}" alt="Cheese Burger" class="burger-img">
                <img src="{{ asset('images/burgers/bacon-burger.jpg') }}" alt="Bacon Burger" class="burger-img">
            </div>
        </div>
        
        <div class="register-right">
            <div class="register-header">
                <h1>Creer un compte</h1>
                <p>Inscrivez-vous pour commander vos burgers preferes</p>
            </div>
            
            <div class="flash-messages">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }}">{{ message }}</div>
                    {% endfor %}
                {% endfor %}
            </div>
            
            <form method="post">
                <div class="form-row">
                    <div class="form-group">
                        <label>Nom</label>
                        <input type="text" name="nom" class="form-control" value="{{ nom|default('') }}" required placeholder="Votre nom">
                    </div>
                    
                    <div class="form-group">
                        <label>Prenom</label>
                        <input type="text" name="prenom" class="form-control" value="{{ prenom|default('') }}" required placeholder="Votre prenom">
                    </div>
                </div>
                
                <div class="form-group">
                    <label>Adresse email</label>
                    <input type="email" name="email" class="form-control" value="{{ email|default('') }}" required placeholder="exemple@email.com">
                </div>
                
                <div class="form-group">
                    <label>Telephone</label>
                    <input type="tel" name="telephone" class="form-control" value="{{ telephone|default('') }}" placeholder="77 123 45 67">
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>Mot de passe</label>
                        <input type="password" name="password" class="form-control" required placeholder="Min. 6 caracteres">
                    </div>
                    
                    <div class="form-group">
                        <label>Confirmer</label>
                        <input type="password" name="confirm_password" class="form-control" required placeholder="Confirmer le mot de passe">
                    </div>
                </div>
                
                <button type="submit" class="btn-register">Creer mon compte</button>
            </form>
            
            <div class="divider">
                <span>ou</span>
            </div>
            
            <div class="login-link">
                <a href="{{ path('app_login') }}">J'ai deja un compte</a>
            </div>
        </div>
    </div>
</body>
</html>

