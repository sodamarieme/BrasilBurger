{% extends 'base.html.twig' %}

{% block title %}Inscription - Brasil Burger{% endblock %}

{% block body %}
<div class="container">
    <div class="section" style="max-width: 500px; margin: 50px auto;">
        <h2 class="section-title" style="text-align: center;">📝 Créer un compte</h2>
        
        {{ form_start(registrationForm) }}
            <div class="form-group">
                <label>👤 Nom</label>
                {{ form_widget(registrationForm.nom, {'attr': {'class': 'form-control', 'placeholder': 'Votre nom'}}) }}
                {{ form_errors(registrationForm.nom) }}
            </div>
            
            <div class="form-group">
                <label>👤 Prénom</label>
                {{ form_widget(registrationForm.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Votre prénom'}}) }}
                {{ form_errors(registrationForm.prenom) }}
            </div>
            
            <div class="form-group">
                <label>📧 Email</label>
                {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control', 'placeholder': 'votre@email.com'}}) }}
                {{ form_errors(registrationForm.email) }}
            </div>
            
            <div class="form-group">
                <label>📱 Téléphone</label>
                {{ form_widget(registrationForm.telephone, {'attr': {'class': 'form-control', 'placeholder': '06 12 34 56 78'}}) }}
                {{ form_errors(registrationForm.telephone) }}
            </div>
            
            <div class="form-group">
                <label>📍 Adresse</label>
                {{ form_widget(registrationForm.adresse, {'attr': {'class': 'form-control', 'placeholder': 'Votre adresse de livraison'}}) }}
                {{ form_errors(registrationForm.adresse) }}
            </div>
            
            <div class="form-group">
                <label>🔑 Mot de passe</label>
                {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control', 'placeholder': 'Minimum 6 caractères'}}) }}
                {{ form_errors(registrationForm.plainPassword) }}
            </div>
            
            <button type="submit" class="btn" style="width: 100%;">✅ S'inscrire</button>
        {{ form_end(registrationForm) }}
        
        <div style="text-align: center; margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee;">
            <p style="color: #666;">Déjà un compte ?</p>
            <a href="{{ path('app_login') }}" class="btn btn-secondary" style="margin-top: 10px;">🔐 Se connecter</a>
        </div>
    </div>
</div>
{% endblock %}
