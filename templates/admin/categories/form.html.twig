{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ category ? 'Modifier' : 'Ajouter' }} une Categorie - Admin{% endblock %}

{% block body %}
<div class="admin-container">
    <div class="section" style="max-width: 600px; margin: 0 auto;">
        <a href="{{ path('app_admin_categories') }}" class="back-link">Retour aux categories</a>
        
        <h2 class="section-title">{{ category ? 'Modifier la Categorie' : 'Ajouter une Categorie' }}</h2>
        
        <form method="post">
            <div class="form-group">
                <label>Nom de la categorie</label>
                <input type="text" name="nom" class="form-control" value="{{ category ? category.nom : '' }}" required placeholder="Ex: Burgers Classiques">
            </div>
            
            <div class="form-group">
                <label>Description</label>
                <textarea name="description" class="form-control" placeholder="Description de la categorie...">{{ category ? category.description : '' }}</textarea>
            </div>
            
            <button type="submit" class="btn" style="width: 100%;">
                {{ category ? 'Enregistrer' : 'Ajouter la categorie' }}
            </button>
        </form>
    </div>
</div>
{% endblock %}

