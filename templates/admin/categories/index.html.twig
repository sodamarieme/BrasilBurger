{% extends 'admin/base_admin.html.twig' %}

{% block title %}Catalogue - Categories{% endblock %}

{% block body %}
<div class="admin-container">
    <div class="admin-section">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 class="admin-section-title" style="margin-bottom: 0; border: none; padding: 0;">Gestion des Categories</h2>
            <a href="{{ path('app_admin_category_new') }}" class="btn">+ Nouvelle Categorie</a>
        </div>
        
        <!-- Sous-navigation Catalogue -->
        <div style="display: flex; gap: 10px; margin-bottom: 25px; flex-wrap: wrap;">
            <a href="{{ path('app_admin_burgers') }}" class="btn btn-secondary">Burgers</a>
            <a href="{{ path('app_admin_menus') }}" class="btn btn-secondary">Menus</a>
            <a href="{{ path('app_admin_complements') }}" class="btn btn-secondary">Complements</a>
            <a href="{{ path('app_admin_categories') }}" class="btn">Categories</a>
        </div>
        
        {% if categories|length > 0 %}
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Description</th>
                        <th>Nb Burgers</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in categories %}
                    <tr>
                        <td><strong>{{ category.nom }}</strong></td>
                        <td>{{ category.description|length > 50 ? category.description|slice(0, 50) ~ '...' : category.description }}</td>
                        <td><span class="badge">{{ category.burgers|length }}</span></td>
                        <td class="action-btns">
                            <a href="{{ path('app_admin_category_edit', {id: category.id}) }}" class="btn-edit">Modifier</a>
                            <form method="post" action="{{ path('app_admin_category_delete', {id: category.id}) }}" style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                                <button type="submit" class="btn-delete" onclick="return confirm('Supprimer cette categorie ?')">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div style="text-align: center; padding: 60px 20px; color: #888;">
            <div style="font-size: 4rem; margin-bottom: 20px; color: var(--primary);">[Cat]</div>
            <h3>Aucune categorie</h3>
            <p>Ajoutez votre premiere categorie</p>
            <a href="{{ path('app_admin_category_new') }}" class="btn" style="margin-top: 15px;">+ Ajouter une categorie</a>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}

