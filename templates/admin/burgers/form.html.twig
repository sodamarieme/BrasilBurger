{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ burger ? 'Modifier' : 'Ajouter' }} un Burger - Admin{% endblock %}

{% block body %}
<div class="admin-container">
    <div class="section" style="max-width: 700px; margin: 0 auto;">
        <a href="{{ path('app_admin_burgers') }}" class="back-link">← Retour au catalogue</a>
        
        <h2 class="section-title">{{ burger ? '✏️ Modifier le Burger' : '➕ Ajouter un Burger' }}</h2>
        
        <form method="post">
            <div class="form-group">
                <label>Nom du burger</label>
                <input type="text" name="nom" class="form-control" value="{{ burger ? burger.nom : '' }}" required placeholder="Ex: Classic Burger">
            </div>
            
            <div class="form-group">
                <label>Description</label>
                <textarea name="description" class="form-control" placeholder="Description du burger...">{{ burger ? burger.description : '' }}</textarea>
            </div>
            
            <div class="form-group">
                <label>Prix (FCFA)</label>
                <input type="number" name="prix" class="form-control" value="{{ burger ? burger.prix : '' }}" required placeholder="Ex: 2500">
            </div>
            
            <div class="form-group">
                <label>URL de l'image</label>
                <input type="text" name="image" class="form-control" value="{{ burger ? burger.image : '' }}" placeholder="https://...">
            </div>
            
            <div class="form-group">
                <label>Catégorie</label>
                <select name="category" class="form-control">
                    <option value="">-- Aucune catégorie --</option>
                    {% for category in categories %}
                    <option value="{{ category.id }}" {{ burger and burger.category and burger.category.id == category.id ? 'selected' : '' }}>
                        {{ category.nom }}
                    </option>
                    {% endfor %}
                </select>
            </div>
            
            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" name="disponible" {{ (not burger or burger.disponible) ? 'checked' : '' }}>
                    Disponible à la vente
                </label>
            </div>
            
            <button type="submit" class="btn" style="width: 100%;">
                {{ burger ? '💾 Enregistrer les modifications' : '➕ Ajouter le burger' }}
            </button>
        </form>
    </div>
</div>
{% endblock %}
