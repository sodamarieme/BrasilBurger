{% extends 'admin/base_admin.html.twig' %}

{% block title %}Catalogue - Complements{% endblock %}

{% block body %}
<div class="admin-container">
    <div class="admin-section">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 class="admin-section-title" style="margin-bottom: 0; border: none; padding: 0;">Gestion des Complements</h2>
            <a href="{{ path('app_admin_complement_new') }}" class="btn">+ Nouveau Complement</a>
        </div>
        
        <!-- Sous-navigation Catalogue -->
        <div style="display: flex; gap: 10px; margin-bottom: 25px; flex-wrap: wrap;">
            <a href="{{ path('app_admin_burgers') }}" class="btn btn-secondary">Burgers</a>
            <a href="{{ path('app_admin_menus') }}" class="btn btn-secondary">Menus</a>
            <a href="{{ path('app_admin_complements') }}" class="btn">Complements</a>
            <a href="{{ path('app_admin_categories') }}" class="btn btn-secondary">Categories</a>
        </div>
        
        {% if complements|length > 0 %}
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Nom</th>
                        <th>Description</th>
                        <th>Prix</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for complement in complements %}
                    <tr>
                        <td>
                            <img src="{{ complement.image ? asset('uploads/complements/' ~ complement.image) : 'https://via.placeholder.com/50x50/ffb347/ffffff?text=C' }}" 
                                 alt="{{ complement.nom }}" 
                                 style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;">
                        </td>
                        <td><strong>{{ complement.nom }}</strong></td>
                        <td>{{ complement.description|length > 40 ? complement.description|slice(0, 40) ~ '...' : complement.description }}</td>
                        <td><strong>{{ complement.prix|number_format(0, ',', ' ') }} FCFA</strong></td>
                        <td>
                            {% if complement.disponible %}
                                <span class="badge badge-success">Disponible</span>
                            {% else %}
                                <span class="badge badge-danger">Indisponible</span>
                            {% endif %}
                        </td>
                        <td class="action-btns">
                            <a href="{{ path('app_admin_complement_edit', {id: complement.id}) }}" class="btn-edit">Modifier</a>
                            <form method="post" action="{{ path('app_admin_complement_archive', {id: complement.id}) }}" style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ complement.id) }}">
                                <button type="submit" class="btn-archive" onclick="return confirm('Archiver ce complement ?')">Archiver</button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div style="text-align: center; padding: 60px 20px; color: #888;">
            <div style="font-size: 4rem; margin-bottom: 20px; color: var(--primary);">[C]</div>
            <h3>Aucun complement</h3>
            <p>Ajoutez votre premier complement</p>
            <a href="{{ path('app_admin_complement_new') }}" class="btn" style="margin-top: 15px;">+ Ajouter un complement</a>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}

