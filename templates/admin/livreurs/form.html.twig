{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ livreur ? 'Modifier' : 'Ajouter' }} un Livreur - Admin{% endblock %}

{% block body %}
<div class="admin-container">
    <div class="section" style="max-width: 600px; margin: 0 auto;">
        <a href="{{ path('app_admin_livreurs') }}" class="back-link">Retour aux livreurs</a>
        
        <h2 class="section-title">{{ livreur ? 'Modifier le Livreur' : 'Ajouter un Livreur' }}</h2>
        
        <form method="post">
            <div class="form-group">
                <label>Prenom</label>
                <input type="text" name="prenom" class="form-control" value="{{ livreur ? livreur.prenom : '' }}" required placeholder="Ex: Mamadou">
            </div>
            
            <div class="form-group">
                <label>Nom</label>
                <input type="text" name="nom" class="form-control" value="{{ livreur ? livreur.nom : '' }}" required placeholder="Ex: Diallo">
            </div>
            
            <div class="form-group">
                <label>Telephone</label>
                <input type="text" name="telephone" class="form-control" value="{{ livreur ? livreur.telephone : '' }}" required placeholder="Ex: 77 123 45 67">
            </div>
            
            <div class="form-group">
                <label>Email (optionnel)</label>
                <input type="email" name="email" class="form-control" value="{{ livreur ? livreur.email : '' }}" placeholder="Ex: mamadou@email.com">
            </div>
            
            <div class="form-group">
                <label>Zones de livraison</label>
                <select name="zones[]" class="form-control" multiple style="min-height: 120px;">
                    {% for zone in zones %}
                    <option value="{{ zone.id }}" {{ livreur and zone in livreur.zones ? 'selected' : '' }}>
                        {{ zone.nom }}
                    </option>
                    {% endfor %}
                </select>
                <small class="form-text">Maintenez Ctrl pour selectionner plusieurs zones</small>
            </div>
            
            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" name="disponible" {{ (not livreur or livreur.disponible) ? 'checked' : '' }}>
                    Disponible pour les livraisons
                </label>
            </div>
            
            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" name="active" {{ (not livreur or livreur.active) ? 'checked' : '' }}>
                    Compte actif
                </label>
            </div>
            
            <button type="submit" class="btn" style="width: 100%;">
                {{ livreur ? 'Enregistrer' : 'Ajouter le livreur' }}
            </button>
        </form>
    </div>
</div>
{% endblock %}

