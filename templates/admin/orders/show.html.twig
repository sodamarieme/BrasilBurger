{% extends 'admin/base_admin.html.twig' %}

{% block title %}Commande #{{ order.id }} - Admin{% endblock %}

{% block body %}
<div class="admin-container">
    <div class="section">
        <a href="{{ path('app_admin_orders') }}" class="back-link">Retour aux commandes</a>
        
        <div class="order-header">
            <div>
                <span class="order-number">Commande #{{ order.id }}</span>
                <p class="text-muted">{{ order.createdAt|date('d/m/Y a H:i') }}</p>
            </div>
            <div>
                {% if order.status == 'pending' %}
                    <span class="badge badge-encours">En cours</span>
                {% elseif order.status == 'ready' %}
                    <span class="badge badge-prete">Prete</span>
                {% elseif order.status == 'completed' %}
                    <span class="badge badge-terminee">Terminee</span>
                {% elseif order.status == 'cancelled' %}
                    <span class="badge badge-annulee">Annulee</span>
                {% endif %}
            </div>
        </div>
        
        <!-- Infos Client -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 30px;">
            <div class="delivery-card">
                <h4 style="margin-bottom: 15px; color: var(--primary);">Client</h4>
                <p><strong>{{ order.user ? order.user.prenom ~ ' ' ~ order.user.nom : 'Client anonyme' }}</strong></p>
                <p>Tel: {{ order.telephone|default('Non renseigne') }}</p>
                <p>Email: {{ order.user ? order.user.email : 'N/A' }}</p>
            </div>
            
            <div class="delivery-card">
                <h4 style="margin-bottom: 15px; color: var(--primary);">Livraison</h4>
                <p><strong>Type:</strong> 
                    {% if order.type == 'livraison' %}
                        Livraison
                    {% elseif order.type == 'surplace' %}
                        Sur place
                    {% else %}
                        A emporter
                    {% endif %}
                </p>
                {% if order.address %}
                <p><strong>Adresse:</strong> {{ order.address }}</p>
                {% endif %}
                {% if order.zone %}
                <p><strong>Zone:</strong> {{ order.zone.nom }}</p>
                {% endif %}
            </div>
        </div>
        
        <!-- Articles -->
        <h3 class="category-title">Articles commandes</h3>
        <div class="order-items">
            {% for item in order.items %}
            <div class="order-item">
                <div>
                    <strong>{{ item.productName }}</strong>
                    <span class="text-muted">(x{{ item.quantity }})</span>
                </div>
                <div>
                    <strong>{{ (item.price * item.quantity)|number_format(0, ',', ' ') }} FCFA</strong>
                </div>
            </div>
            {% else %}
            <p class="text-muted">Aucun article</p>
            {% endfor %}
        </div>
        
        <!-- Total -->
        <div style="background: linear-gradient(135deg, #fff5e6 0%, #ffe6cc 100%); padding: 20px; border-radius: 12px; margin-top: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 20px; font-weight: bold;">Total</span>
                <span style="font-size: 28px; font-weight: bold; color: var(--primary);">{{ order.total|number_format(0, ',', ' ') }} FCFA</span>
            </div>
        </div>
        
        <!-- Actions -->
        <div style="display: flex; gap: 15px; margin-top: 30px; flex-wrap: wrap;">
            {% if order.status == 'pending' %}
            <form action="{{ path('app_admin_order_status', {id: order.id, status: 'ready'}) }}" method="post">
                <button type="submit" class="btn btn-success">Marquer comme prete</button>
            </form>
            {% endif %}
            {% if order.status == 'ready' %}
            <form action="{{ path('app_admin_order_status', {id: order.id, status: 'completed'}) }}" method="post">
                <button type="submit" class="btn btn-success">Terminer la commande</button>
            </form>
            {% endif %}
            {% if order.status != 'cancelled' and order.status != 'completed' %}
            <form action="{{ path('app_admin_order_status', {id: order.id, status: 'cancelled'}) }}" method="post">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Annuler cette commande ?')">Annuler</button>
            </form>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

