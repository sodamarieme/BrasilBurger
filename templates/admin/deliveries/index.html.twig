{% extends 'admin/base_admin.html.twig' %}

{% block title %}Livraisons - Admin{% endblock %}

{% block body %}

<div class="admin-container">
    <div class="admin-section">
        <h2 class="section-title">Gestion des Livraisons</h2>
        
        <div class="delivery-grid">
            <!-- Colonne gauche: Livraisons a affecter et en cours -->
            <div class="delivery-column">
                <h3 class="column-title">Livraisons a gerer</h3>
                
                {% set pendingDeliveries = [] %}
                
                {# Ajouter les livraisons sans livreur ou en cours #}
                {% for delivery in deliveries|default([]) %}
                    {% if delivery.statut != 'livree' and delivery.statut != 'annulee' %}
                        {% set pendingDeliveries = pendingDeliveries|merge([delivery]) %}
                    {% endif %}
                {% endfor %}
                
                {% if pendingDeliveries|length > 0 %}
                    {% for delivery in pendingDeliveries %}
                    <div class="delivery-card">
                        <div class="delivery-info">
                            <div class="delivery-id">#{{ delivery.commande.id }}</div>
                            <div class="delivery-client">
                                <strong>{{ delivery.commande.client.prenom }} {{ delivery.commande.client.nom }}</strong>
                                <small>Tel: {{ delivery.commande.client.telephone|default('N/A') }}</small>
                            </div>
                            <div class="delivery-address">
                                Adresse: {{ delivery.adresse|default(delivery.commande.adresseLivraison|default('Adresse non specifiee')) }}
                            </div>
                            {% if delivery.zone %}
                            <div class="delivery-zone">
                                Zone: <strong>{{ delivery.zone.nom }}</strong> - {{ delivery.zone.prixLivraison|number_format(0, ' ', ' ') }} FCFA
                            </div>
                            {% endif %}
                            <div class="delivery-amount">
                                {{ delivery.commande.total|number_format(0, ' ', ' ') }} FCFA
                            </div>
                            <div class="delivery-status-badge">
                                {% if delivery.statut == 'en_attente' %}
                                    <span class="status-pill status-pending">En attente</span>
                                {% elseif delivery.statut == 'assignee' %}
                                    <span class="status-pill status-assigned">Assignee</span>
                                {% elseif delivery.statut == 'en_livraison' %}
                                    <span class="status-pill status-delivering">En livraison</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="delivery-actions">
                            <button class="btn-action btn-assign" onclick="showLivreurModal({{ delivery.id }})">
                                Affecter un livreur
                            </button>
                            {% if delivery.livreur %}
                                {% if delivery.statut == 'assignee' or delivery.statut == 'en_attente' %}
                                <form action="{{ path('app_admin_delivery_status', {id: delivery.id}) }}" method="POST" style="display:inline;">
                                    <input type="hidden" name="statut" value="en_livraison">
                                    <button type="submit" class="btn-action btn-success">Lancer</button>
                                </form>
                                {% elseif delivery.statut == 'en_livraison' %}
                                <form action="{{ path('app_admin_delivery_status', {id: delivery.id}) }}" method="POST" style="display:inline;">
                                    <input type="hidden" name="statut" value="livree">
                                    <button type="submit" class="btn-action btn-success">Terminer</button>
                                </form>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                {% else %}
                <div class="empty-state">
                    <div class="empty-icon">[OK]</div>
                    <h3>Aucune livraison en attente</h3>
                </div>
                {% endif %}
            </div>
            
            <!-- Colonne droite: Livreurs disponibles -->
            <div class="delivery-column">
                <h3 class="column-title">Livreurs disponibles</h3>
                
                {% if livreurs|default([])|length > 0 %}
                    {% for livreur in livreurs %}
                    <div class="livreur-card">
                        <div class="livreur-avatar">{{ livreur.prenom|first|upper }}</div>
                        <div class="livreur-info">
                            <strong>{{ livreur.prenom }} {{ livreur.nom }}</strong>
                            <small>Tel: {{ livreur.telephone|default('N/A') }}</small>
                            {% if livreur.zones|length > 0 %}
                            <span class="livreur-zone">{{ livreur.zones|map(z => z.nom)|join(', ') }}</span>
                            {% endif %}
                        </div>
                        <div class="livreur-status">
                            {% set activeDeliveries = 0 %}
                            {% for delivery in deliveries|default([]) %}
                                {% if delivery.livreur and delivery.livreur.id == livreur.id and delivery.statut == 'en_livraison' %}
                                    {% set activeDeliveries = activeDeliveries + 1 %}
                                {% endif %}
                            {% endfor %}
                            
                            {% if activeDeliveries > 0 %}
                                <span class="status-pill status-delivering">En course ({{ activeDeliveries }})</span>
                            {% else %}
                                <span class="status-pill status-available">Disponible</span>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                {% else %}
                <div class="empty-state">
                    <div class="empty-icon">[L]</div>
                    <h3>Aucun livreur</h3>
                    <a href="{{ path('app_admin_livreur_new') }}" class="btn">+ Ajouter un livreur</a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Modal Affectation Livreur -->
<div id="livreurModal" class="modal" style="display: none;">
    <div class="modal-content">
        <h3>Affecter un livreur</h3>
        <form id="assignForm" method="POST">
            <div class="form-group">
                <label>Choisir un livreur</label>
                <select name="livreur_id" class="form-control" required>
                    <option value="">-- Selectionner --</option>
                    {% for livreur in livreurs|default([]) %}
                        {% if livreur.disponible %}
                        <option value="{{ livreur.id }}">{{ livreur.prenom }} {{ livreur.nom }}</option>
                        {% endif %}
                    {% endfor %}
                </select>
            </div>
            <div style="display: flex; gap: 10px; margin-top: 20px;">
                <button type="submit" class="btn">Affecter</button>
                <button type="button" class="btn btn-secondary" onclick="closeModal()">Annuler</button>
            </div>
        </form>
    </div>
</div>

<script>
function showLivreurModal(deliveryId) {
    document.getElementById('assignForm').action = '/admin/livraisons/' + deliveryId + '/assigner';
    document.getElementById('livreurModal').style.display = 'flex';
}

function closeModal() {
    document.getElementById('livreurModal').style.display = 'none';
}
</script>

<style>
.modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    justify-content: center;
    align-items: center;
    z-index: 1000;
}
.modal-content {
    background: white;
    padding: 30px;
    border-radius: 15px;
    max-width: 400px;
    width: 90%;
}
.btn-change {
    background: #6c757d;
    color: white;
    border: none;
    padding: 8px 15px;
    border-radius: 5px;
    cursor: pointer;
    font-size: 12px;
}
.btn-change:hover {
    background: #5a6268;
}
.delivery-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-end;
}
</style>
{% endblock %}
