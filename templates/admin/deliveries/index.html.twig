{% extends 'admin/base_admin.html.twig' %}

{% block title %}Livraisons - Admin{% endblock %}

{% block body %}

<div class="admin-container">
    <div class="admin-section">
        <h2 class="section-title">🚚 Gestion des Livraisons</h2>
        
        <div class="delivery-grid">
            <!-- Colonne gauche: Commandes à livrer -->
            <div class="delivery-column">
                <h3 class="column-title">📦 Commandes à livrer</h3>
                
                {% set pendingDeliveries = [] %}
                {% if ordersByZone|default({})|length > 0 %}
                    {% for zoneName, zoneData in ordersByZone %}
                        {% for order in zoneData.orders %}
                            {% if order.statut != 'livree' and order.statut != 'annulee' %}
                                {% set pendingDeliveries = pendingDeliveries|merge([{order: order, zone: zoneData.zone}]) %}
                            {% endif %}
                        {% endfor %}
                    {% endfor %}
                {% endif %}
                
                {% if pendingDeliveries|length > 0 %}
                    {% for item in pendingDeliveries %}
                    <div class="delivery-card">
                        <div class="delivery-info">
                            <div class="delivery-id">#{{ item.order.id }}</div>
                            <div class="delivery-client">
                                <strong>{{ item.order.client.prenom }} {{ item.order.client.nom }}</strong>
                                <small>📞 {{ item.order.client.telephone|default('N/A') }}</small>
                            </div>
                            <div class="delivery-address">
                                📍 {{ item.order.adresseLivraison|default('Adresse non spécifiée') }}
                            </div>
                            <div class="delivery-zone">
                                Zone: <strong>{{ item.zone.nom }}</strong> - {{ item.zone.prixLivraison|number_format(0, ' ', ' ') }} FCFA
                            </div>
                            <div class="delivery-amount">
                                {{ item.order.total|number_format(0, ' ', ' ') }} FCFA
                            </div>
                        </div>
                        <div class="delivery-actions">
                            {% if item.order.delivery.livreur %}
                                <span class="livreur-assigned">
                                    🛵 {{ item.order.delivery.livreur.prenom }}
                                </span>
                                <form action="{{ path('app_admin_delivery_status', {id: item.order.delivery.id}) }}" method="POST">
                                    <input type="hidden" name="statut" value="en_livraison">
                                    <button type="submit" class="btn-action btn-success">🚀 Lancer</button>
                                </form>
                            {% else %}
                                <button class="btn-action btn-assign" onclick="showLivreurModal({{ item.order.delivery.id }})">
                                    📝 Affecter un livreur
                                </button>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                {% else %}
                <div class="empty-state">
                    <div class="empty-icon">✅</div>
                    <h3>Toutes les livraisons sont terminées</h3>
                </div>
                {% endif %}
            </div>
            
            <!-- Colonne droite: Livreurs disponibles -->
            <div class="delivery-column">
                <h3 class="column-title">🛵 Livreurs disponibles</h3>
                
                {% if livreurs|default([])|length > 0 %}
                    {% for livreur in livreurs %}
                    <div class="livreur-card">
                        <div class="livreur-avatar">{{ livreur.prenom|first|upper }}</div>
                        <div class="livreur-info">
                            <strong>{{ livreur.prenom }} {{ livreur.nom }}</strong>
                            <small>📞 {{ livreur.telephone|default('N/A') }}</small>
                            {% if livreur.zones|length > 0 %}
                            <span class="livreur-zone">📍 {{ livreur.zones|map(z => z.nom)|join(', ') }}</span>
                            {% endif %}
                        </div>
                        <div class="livreur-status">
                            {% set activeDeliveries = 0 %}
                            {% if ordersByZone|default({})|length > 0 %}
                                {% for zoneName, zoneData in ordersByZone %}
                                    {% for order in zoneData.orders %}
                                        {% if order.delivery.livreur and order.delivery.livreur.id == livreur.id and order.statut == 'en_livraison' %}
                                            {% set activeDeliveries = activeDeliveries + 1 %}
                                        {% endif %}
                                    {% endfor %}
                                {% endfor %}
                            {% endif %}
                            
                            {% if activeDeliveries > 0 %}
                                <span class="status-pill status-delivering">En course ({{ activeDeliveries }})</span>
                            {% else %}
                                <span class="status-pill status-available">Disponible</span>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                {% else %}
                <div class="empty-state">
                    <div class="empty-icon">🛵</div>
                    <h3>Aucun livreur</h3>
                    <p>Ajoutez des livreurs pour gérer les livraisons</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Modal pour affecter un livreur -->
<div id="livreurModal" class="modal" style="display: none;">
    <div class="modal-content">
        <h3>Affecter un livreur</h3>
        <form id="affectLivreurForm" method="POST">
            <select name="livreur_id" class="form-control" required>
                <option value="">Sélectionner un livreur</option>
                {% for livreur in livreurs|default([]) %}
                <option value="{{ livreur.id }}">{{ livreur.prenom }} {{ livreur.nom }}{% if livreur.zones|length > 0 %} ({{ livreur.zones|map(z => z.nom)|join(', ') }}){% endif %}</option>
                {% endfor %}
            </select>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="closeLivreurModal()">Annuler</button>
                <button type="submit" class="btn btn-primary">Affecter</button>
            </div>
        </form>
    </div>
</div>

<script>
function showLivreurModal(deliveryId) {
    document.getElementById('affectLivreurForm').action = '/admin/delivery/' + deliveryId + '/assign';
    document.getElementById('livreurModal').style.display = 'flex';
}

function closeLivreurModal() {
    document.getElementById('livreurModal').style.display = 'none';
}
</script>
{% endblock %}
