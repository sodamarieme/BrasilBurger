{% extends 'base.html.twig' %}

{% block title %}{{ menu ? 'Modifier' : 'Ajouter' }} un Menu - Admin{% endblock %}

{% block body %}
<div class="container">
    <div class="section" style="max-width: 700px; margin: 0 auto;">
        <a href="{{ path('app_admin_menus') }}" class="back-link">← Retour aux menus</a>
        
        <h2 class="section-title">{{ menu ? '✏️ Modifier le Menu' : '➕ Ajouter un Menu' }}</h2>
        
        <form method="post">
            <div class="form-group">
                <label>Nom du menu</label>
                <input type="text" name="nom" class="form-control" value="{{ menu ? menu.nom : '' }}" required placeholder="Ex: Menu Classic">
            </div>
            
            <div class="form-group">
                <label>Description</label>
                <textarea name="description" class="form-control" placeholder="Description du menu...">{{ menu ? menu.description : '' }}</textarea>
            </div>
            
            <div class="form-group">
                <label>Prix (FCFA)</label>
                <input type="number" name="prix" class="form-control" value="{{ menu ? menu.prix : '' }}" required placeholder="Ex: 4000">
            </div>
            
            <div class="form-group">
                <label>URL de l'image</label>
                <input type="text" name="image" class="form-control" value="{{ menu ? menu.image : '' }}" placeholder="https://...">
            </div>
            
            <div class="form-group">
                <label>Burgers inclus</label>
                <div class="checkbox-grid">
                    {% for burger in burgers %}
                    <label class="checkbox-item">
                        <input type="checkbox" name="burgers[]" value="{{ burger.id }}" 
                            {{ menu and burger in menu.burgers.toArray() ? 'checked' : '' }}>
                        🍔 {{ burger.nom }} ({{ burger.prix|number_format(0, ',', ' ') }} FCFA)
                    </label>
                    {% endfor %}
                </div>
            </div>
            
            <div class="form-group">
                <label>Compléments inclus</label>
                <div class="checkbox-grid">
                    {% for complement in complements %}
                    <label class="checkbox-item">
                        <input type="checkbox" name="complements[]" value="{{ complement.id }}"
                            {{ menu and complement in menu.complements.toArray() ? 'checked' : '' }}>
                        🍟 {{ complement.nom }} ({{ complement.prix|number_format(0, ',', ' ') }} FCFA)
                    </label>
                    {% endfor %}
                </div>
            </div>
            
            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" name="disponible" {{ (not menu or menu.disponible) ? 'checked' : '' }}>
                    Disponible à la vente
                </label>
            </div>
            
            <button type="submit" class="btn" style="width: 100%;">
                {{ menu ? '💾 Enregistrer' : '➕ Ajouter le menu' }}
            </button>
        </form>
    </div>
</div>
{% endblock %}
