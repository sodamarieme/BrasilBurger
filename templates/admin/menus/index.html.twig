{% extends 'base.html.twig' %}

{% block title %}Catalogue - Menus{% endblock %}

{% block body %}
{% include 'admin/_navbar.html.twig' %}

<div class="admin-container">
    <div class="admin-section">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 class="admin-section-title" style="margin-bottom: 0; border: none; padding: 0;">🍽️ Gestion des Menus</h2>
            <a href="{{ path('app_admin_menu_new') }}" class="btn">➕ Nouveau Menu</a>
        </div>
        
        <!-- Sous-navigation Catalogue -->
        <div style="display: flex; gap: 10px; margin-bottom: 25px; flex-wrap: wrap;">
            <a href="{{ path('app_admin_burgers') }}" class="btn btn-secondary">🍔 Burgers</a>
            <a href="{{ path('app_admin_menus') }}" class="btn">🍽️ Menus</a>
            <a href="{{ path('app_admin_complements') }}" class="btn btn-secondary">🍟 Compléments</a>
            <a href="{{ path('app_admin_categories') }}" class="btn btn-secondary">📁 Catégories</a>
        </div>
        
        {% if menus|length > 0 %}
        <table class="data-table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Nom</th>
                    <th>Burgers</th>
                    <th>Compléments</th>
                    <th>Prix</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for menu in menus %}
                <tr>
                    <td>
                        <img src="{{ menu.image ? asset('uploads/menus/' ~ menu.image) : 'https://via.placeholder.com/50x50/ff6b35/ffffff?text=🍽️' }}" 
                             alt="{{ menu.nom }}" 
                             style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;">
                    </td>
                    <td><strong>{{ menu.nom }}</strong></td>
                    <td>{{ menu.burgers|length }}</td>
                    <td>{{ menu.complements|length }}</td>
                    <td><strong>{{ menu.prix|number_format(0, ',', ' ') }} FCFA</strong></td>
                    <td>
                        {% if menu.disponible %}
                            <span class="badge badge-success">✅ Disponible</span>
                        {% else %}
                            <span class="badge badge-danger">❌ Indisponible</span>
                        {% endif %}
                    </td>
                    <td class="action-btns">
                        <a href="{{ path('app_admin_menu_edit', {id: menu.id}) }}" class="btn-edit">✏️</a>
                        <form method="post" action="{{ path('app_admin_menu_archive', {id: menu.id}) }}" style="display: inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ menu.id) }}">
                            <button type="submit" class="btn-archive" onclick="return confirm('Archiver ce menu ?')">📦</button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <div style="text-align: center; padding: 60px 20px; color: #888;">
            <div style="font-size: 4rem; margin-bottom: 20px;">🍽️</div>
            <h3>Aucun menu</h3>
            <p>Ajoutez votre premier menu</p>
            <a href="{{ path('app_admin_menu_new') }}" class="btn" style="margin-top: 15px;">➕ Ajouter un menu</a>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
