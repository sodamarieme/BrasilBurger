{% extends 'admin/base_admin.html.twig' %}

{% block title %}Dashboard - Admin Brasil Burger{% endblock %}

{% block body %}

<div class="admin-container">
    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-value">{{ stats.pending|default(0) }}</div>
            <div class="stat-label">Commandes en cours</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">{{ stats.completed|default(0) }}</div>
            <div class="stat-label">Commandes validees</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">{{ stats.revenue|default(0)|number_format(0, ',', ' ') }}</div>
            <div class="stat-label">Recettes (FCFA)</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">{{ stats.cancelled|default(0) }}</div>
            <div class="stat-label">Commandes annulees</div>
        </div>
    </div>

    <!-- Top 5 Produits -->
    <div class="admin-section">
        <h2 class="section-title">Top 5 - Produits les plus vendus</h2>
        
        <div class="top-products-list">
            {% for product in topProducts|default([]) %}
            <div class="top-product-item">
                <div class="product-info">
                    <span class="product-name">{{ product.nom }}</span>
                </div>
                <div class="product-stats">
                    {{ product.quantite }} vendus - {{ product.total|number_format(0, ' ', ' ') }} FCFA
                </div>
            </div>
            {% else %}
            <div class="top-product-item">
                <div class="product-info">
                    <span class="product-name">Classic Burger</span>
                </div>
                <div class="product-stats">15 vendus - 37 500 FCFA</div>
            </div>
            <div class="top-product-item">
                <div class="product-info">
                    <span class="product-name">Menu Classic</span>
                </div>
                <div class="product-stats">12 vendus - 48 000 FCFA</div>
            </div>
            <div class="top-product-item">
                <div class="product-info">
                    <span class="product-name">Cheese Burger</span>
                </div>
                <div class="product-stats">10 vendus - 30 000 FCFA</div>
            </div>
            <div class="top-product-item">
                <div class="product-info">
                    <span class="product-name">Menu Cheese</span>
                </div>
                <div class="product-stats">8 vendus - 36 000 FCFA</div>
            </div>
            <div class="top-product-item">
                <div class="product-info">
                    <span class="product-name">Bacon Burger</span>
                </div>
                <div class="product-stats">7 vendus - 24 500 FCFA</div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}

