{% extends 'base.html.twig' %}

{% block title %}Mon Profil - Brasil Burger{% endblock %}

{% block body %}
<div class="container">
    <div class="section">
        <h2 class="section-title">👤 Mon Profil</h2>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
            <!-- Informations personnelles -->
            <div style="background: #fff; border-radius: 20px; padding: 30px; box-shadow: 0 5px 20px rgba(0,0,0,0.05);">
                <h3 style="color: var(--primary); margin-bottom: 20px;">📋 Informations personnelles</h3>
                
                <div style="margin-bottom: 15px;">
                    <span style="color: #888; font-size: 0.9rem;">Nom complet</span>
                    <div style="font-size: 1.1rem; font-weight: 600;">{{ app.user.prenom }} {{ app.user.nom }}</div>
                </div>
                
                <div style="margin-bottom: 15px;">
                    <span style="color: #888; font-size: 0.9rem;">Email</span>
                    <div style="font-size: 1.1rem;">{{ app.user.email }}</div>
                </div>
                
                <div style="margin-bottom: 15px;">
                    <span style="color: #888; font-size: 0.9rem;">Téléphone</span>
                    <div style="font-size: 1.1rem;">{{ app.user.telephone ?: 'Non renseigné' }}</div>
                </div>
                
                <div style="margin-bottom: 20px;">
                    <span style="color: #888; font-size: 0.9rem;">Adresse</span>
                    <div style="font-size: 1.1rem;">{{ app.user.adresse ?: 'Non renseignée' }}</div>
                </div>
                
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <a href="{{ path('app_profile_edit') }}" class="btn">✏️ Modifier</a>
                    <a href="{{ path('app_profile_password') }}" class="btn btn-secondary">🔑 Mot de passe</a>
                </div>
            </div>
            
            <!-- Statistiques -->
            <div style="background: #fff; border-radius: 20px; padding: 30px; box-shadow: 0 5px 20px rgba(0,0,0,0.05);">
                <h3 style="color: var(--primary); margin-bottom: 20px;">📊 Mes statistiques</h3>
                
                <div class="stats-grid" style="grid-template-columns: 1fr 1fr;">
                    <div class="stat-card">
                        <div class="stat-icon">📦</div>
                        <div class="stat-value">{{ orders|length }}</div>
                        <div class="stat-label">Commandes</div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-icon">💰</div>
                        <div class="stat-value">{{ totalSpent|number_format(0, ',', ' ') }}</div>
                        <div class="stat-label">FCFA dépensés</div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Dernières commandes -->
        <div style="background: #fff; border-radius: 20px; padding: 30px; box-shadow: 0 5px 20px rgba(0,0,0,0.05); margin-top: 30px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 style="color: var(--primary); margin: 0;">📦 Mes dernières commandes</h3>
                <a href="{{ path('app_orders') }}" class="btn btn-secondary btn-sm">Voir tout</a>
            </div>
            
            {% if orders|length > 0 %}
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>N° Commande</th>
                            <th>Date</th>
                            <th>Montant</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for order in orders|slice(0, 5) %}
                        <tr>
                            <td><strong>#{{ order.id }}</strong></td>
                            <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
                            <td>{{ order.total|number_format(0, ',', ' ') }} FCFA</td>
                            <td>
                                {% set statusClass = {
                                    'en_attente': 'badge-warning',
                                    'confirmee': 'badge-info',
                                    'en_preparation': 'badge-info',
                                    'en_livraison': 'badge-primary',
                                    'livree': 'badge-success',
                                    'annulee': 'badge-danger'
                                } %}
                                <span class="badge {{ statusClass[order.statut] ?? 'badge-secondary' }}">
                                    {{ order.statut|replace({'_': ' '})|capitalize }}
                                </span>
                            </td>
                            <td>
                                <a href="{{ path('app_order_show', {id: order.id}) }}" class="btn-edit">👁️</a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div style="text-align: center; padding: 40px; color: #888;">
                    <div style="font-size: 3rem; margin-bottom: 15px;">📦</div>
                    <p>Vous n'avez pas encore passé de commande</p>
                    <a href="{{ path('app_menu') }}" class="btn" style="margin-top: 15px;">🍔 Commander maintenant</a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
