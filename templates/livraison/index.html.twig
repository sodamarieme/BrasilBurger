{% extends 'base.html.twig' %}

{% block title %}Livraison - Brasil Burger{% endblock %}

{% block body %}
<section class="hero-small">
    <div class="container">
        <h1 class="hero-title animate-fadeIn">Livraison</h1>
        <p class="hero-subtitle animate-fadeIn">Nous livrons vos burgers chauds et delicieux chez vous !</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <h2 class="section-title">Zones de livraison</h2>
        
        <div class="zones-grid">
            {% for zone in zones %}
            <div class="zone-card animate-fadeInUp" style="animation-delay: {{ loop.index * 0.1 }}s">
                <h3 class="zone-name">{{ zone.nom }}</h3>
                <div class="zone-price">
                    <span class="price-label">Frais de livraison</span>
                    <span class="price-value">{{ zone.prixLivraison|number_format(0, ',', ' ') }} FCFA</span>
                </div>
            </div>
            {% else %}
            <div class="empty-state">
                <p>Aucune zone de livraison disponible pour le moment.</p>
            </div>
            {% endfor %}
        </div>

        <div class="delivery-info animate-fadeIn">
            <h3>Informations de livraison</h3>
            <div class="info-grid">
                <div class="info-item">
                    <div>
                        <strong>Delai de livraison</strong>
                        <p>30-45 minutes en moyenne</p>
                    </div>
                </div>
                <div class="info-item">
                    <div>
                        <strong>Contact</strong>
                        <p>+221 77 123 45 67</p>
                    </div>
                </div>
                <div class="info-item">
                    <div>
                        <strong>Horaires</strong>
                        <p>10h - 23h tous les jours</p>
                    </div>
                </div>
                <div class="info-item">
                    <div>
                        <strong>Paiement</strong>
                        <p>Especes ou Wave/Orange Money</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

