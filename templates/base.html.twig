<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Brasil Burger{% endblock %}</title>
        <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
        
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('css/style.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <!-- Navigation -->
        <nav class="navbar">
            <div class="container">
                <a href="{{ path('app_home') }}" class="logo">
                    <span class="logo-icon">B</span>
                    <span class="logo-text">Brasil Burger</span>
                </a>
                
                <button class="nav-toggle" id="navToggle" onclick="document.getElementById('navMenu').classList.toggle('active')">
                    ☰
                </button>
                
                <ul class="nav-menu" id="navMenu">
                    <li><a href="{{ path('app_home') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}active{% endif %}">Accueil</a></li>
                    <li><a href="{{ path('app_cart') }}" class="nav-link cart-link {% if 'cart' in app.request.attributes.get('_route') %}active{% endif %}">
                        Panier
                        <span class="cart-count" id="cartCount">0</span>
                    </a></li>
                    <li><a href="{{ path('app_orders') }}" class="nav-link {% if 'order' in app.request.attributes.get('_route') %}active{% endif %}">Commandes</a></li>
                    <li><a href="{{ path('app_livraison') }}" class="nav-link {% if 'livraison' in app.request.attributes.get('_route') %}active{% endif %}">Livraison</a></li>
                    <li><a href="{{ path('app_logout') }}" class="btn-logout">Déconnexion</a></li>
                </ul>
            </div>
        </nav>

        <!-- Flash Messages -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">
                    <div class="container">
                        {{ message }}
                        <button class="alert-close">&times;</button>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}

        <!-- Main Content -->
        <main>
            {% block body %}{% endblock %}
        </main>

        <!-- Footer -->
        <footer class="footer">
            <div class="container">
                <p class="footer-text">
                    &copy; {{ 'now'|date('Y') }} <span class="footer-brand">Brasil Burger</span>. Tous droits réservés.
                </p>
            </div>
        </footer>

        <script>
            // Close alerts
            document.querySelectorAll('.alert-close').forEach(btn => {
                btn.addEventListener('click', function() {
                    this.parentElement.remove();
                });
            });
            
            // Update cart count from localStorage
            function updateCartCount() {
                const cart = JSON.parse(localStorage.getItem('cart') || '[]');
                const count = cart.reduce((sum, item) => sum + item.quantity, 0);
                const countEl = document.getElementById('cartCount');
                if (countEl) countEl.textContent = count;
            }
            updateCartCount();
        </script>
        
        {% block javascripts_bottom %}{% endblock %}
    </body>
</html>

