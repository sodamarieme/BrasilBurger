{% extends 'base.html.twig' %}

{% block title %}Commande #{{ order.id }} - Brasil Burger{% endblock %}

{% block body %}
<div class="container">
    <div class="section" style="max-width: 800px; margin: 0 auto;">
        <a href="{{ path('app_orders') }}" class="back-link">← Retour à mes commandes</a>
        
        <h2 class="section-title">📦 Commande #{{ order.id }}</h2>
        
        <!-- Statut -->
        <div style="background: linear-gradient(135deg, #fff5eb 0%, #fff0e0 100%); padding: 25px; border-radius: 15px; margin-bottom: 30px; text-align: center;">
            {% set statusConfig = {
                'en_attente': {'class': 'badge-warning', 'icon': '⏳', 'text': 'En attente de confirmation'},
                'confirmee': {'class': 'badge-info', 'icon': '✅', 'text': 'Commande confirmée'},
                'en_preparation': {'class': 'badge-info', 'icon': '👨‍🍳', 'text': 'En cours de préparation'},
                'en_livraison': {'class': 'badge-primary', 'icon': '🚚', 'text': 'En cours de livraison'},
                'livree': {'class': 'badge-success', 'icon': '✔️', 'text': 'Livrée'},
                'annulee': {'class': 'badge-danger', 'icon': '❌', 'text': 'Annulée'}
            } %}
            {% set config = statusConfig[order.statut] ?? {'class': 'badge-secondary', 'icon': '📦', 'text': order.statut} %}
            
            <span style="font-size: 3rem;">{{ config.icon }}</span>
            <h3 style="margin: 15px 0 5px;">{{ config.text }}</h3>
            <span class="badge {{ config.class }}" style="font-size: 1rem;">
                {{ order.statut|replace({'_': ' '})|upper }}
            </span>
        </div>
        
        <!-- Timeline de progression -->
        <div style="display: flex; justify-content: space-between; margin-bottom: 40px; position: relative;">
            {% set steps = ['en_attente', 'confirmee', 'en_preparation', 'en_livraison', 'livree'] %}
            {% set stepIcons = {'en_attente': '⏳', 'confirmee': '✅', 'en_preparation': '👨‍🍳', 'en_livraison': '🚚', 'livree': '🎉'} %}
            {% set stepLabels = {'en_attente': 'Attente', 'confirmee': 'Confirmée', 'en_preparation': 'Préparation', 'en_livraison': 'Livraison', 'livree': 'Livrée'} %}
            
            <div style="position: absolute; top: 20px; left: 10%; right: 10%; height: 4px; background: #ddd; z-index: 0;">
                {% set currentIndex = 0 %}
                {% for i, step in steps %}
                    {% if order.statut == step %}
                        {% set currentIndex = i %}
                    {% endif %}
                {% endfor %}
                <div style="width: {{ (currentIndex / 4) * 100 }}%; height: 100%; background: var(--primary); transition: width 0.5s;"></div>
            </div>
            
            {% for step in steps %}
                {% set isActive = false %}
                {% set isPast = false %}
                {% set found = false %}
                {% for s in steps %}
                    {% if s == order.statut %}
                        {% set found = true %}
                    {% endif %}
                    {% if s == step %}
                        {% if found %}
                            {% set isPast = false %}
                        {% else %}
                            {% set isPast = true %}
                        {% endif %}
                        {% if s == order.statut %}
                            {% set isActive = true %}
                        {% endif %}
                    {% endif %}
                {% endfor %}
                
                <div style="text-align: center; z-index: 1;">
                    <div style="width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px; font-size: 1.2rem; 
                        {% if isActive %}
                            background: var(--primary); color: white;
                        {% elseif isPast %}
                            background: var(--primary); color: white; opacity: 0.7;
                        {% else %}
                            background: #ddd; color: #666;
                        {% endif %}
                    ">
                        {{ stepIcons[step] }}
                    </div>
                    <span style="font-size: 0.75rem; color: {{ isActive ? 'var(--primary)' : '#888' }};">{{ stepLabels[step] }}</span>
                </div>
            {% endfor %}
        </div>
        
        <!-- Détails de la commande -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px;">
            <div style="background: #f8f9fa; padding: 20px; border-radius: 15px;">
                <h4 style="color: var(--primary); margin-bottom: 15px;">📅 Informations</h4>
                <div style="margin-bottom: 10px;">
                    <span style="color: #888;">Date:</span>
                    <strong>{{ order.createdAt|date('d/m/Y à H:i') }}</strong>
                </div>
                <div>
                    <span style="color: #888;">Paiement:</span>
                    <strong>{{ order.modePaiement|default('Espèces')|capitalize }}</strong>
                </div>
            </div>
            
            <div style="background: #f8f9fa; padding: 20px; border-radius: 15px;">
                <h4 style="color: var(--primary); margin-bottom: 15px;">📍 Livraison</h4>
                <div style="margin-bottom: 10px;">
                    <span style="color: #888;">Adresse:</span>
                    <strong>{{ order.adresseLivraison }}</strong>
                </div>
                {% if order.zone %}
                <div>
                    <span style="color: #888;">Zone:</span>
                    <strong>{{ order.zone.nom }}</strong>
                </div>
                {% endif %}
            </div>
        </div>
        
        <!-- Articles -->
        <div style="background: #fff; border: 2px solid #eee; padding: 25px; border-radius: 15px; margin-bottom: 30px;">
            <h4 style="color: var(--primary); margin-bottom: 20px;">🛒 Articles commandés</h4>
            
            {% for item in order.items %}
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 15px 0; border-bottom: 1px solid #eee;">
                <div style="display: flex; align-items: center; gap: 15px;">
                    <span style="font-size: 1.5rem;">
                        {% if item.burger %}🍔{% elseif item.menu %}🍽️{% else %}🍟{% endif %}
                    </span>
                    <div>
                        <strong>{{ item.burger ? item.burger.nom : (item.menu ? item.menu.nom : 'Article') }}</strong>
                        <div style="font-size: 0.85rem; color: #888;">Quantité: {{ item.quantity }}</div>
                    </div>
                </div>
                <strong>{{ (item.prix * item.quantity)|number_format(0, ',', ' ') }} FCFA</strong>
            </div>
            {% endfor %}
        </div>
        
        <!-- Total -->
        <div style="background: linear-gradient(135deg, #fff5eb 0%, #fff0e0 100%); padding: 25px; border-radius: 15px;">
            {% set subtotal = order.total - (order.fraisLivraison ?? 0) %}
            <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                <span>Sous-total:</span>
                <span>{{ subtotal|number_format(0, ',', ' ') }} FCFA</span>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
                <span>Frais de livraison:</span>
                <span>{{ (order.fraisLivraison ?? 0)|number_format(0, ',', ' ') }} FCFA</span>
            </div>
            <hr style="border: none; border-top: 2px dashed var(--primary); margin-bottom: 15px;">
            <div style="display: flex; justify-content: space-between; font-size: 1.5rem;">
                <strong>Total payé:</strong>
                <strong style="color: var(--primary);">{{ order.total|number_format(0, ',', ' ') }} FCFA</strong>
            </div>
        </div>
        
        {% if order.statut == 'en_attente' %}
        <div style="margin-top: 30px; text-align: center;">
            <form method="post" action="{{ path('app_order_cancel', {id: order.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler cette commande ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('cancel_order') }}">
                <button type="submit" class="btn btn-danger">❌ Annuler la commande</button>
            </form>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
