{% extends 'base.html.twig' %}

{% block title %}Mes Commandes - Brasil Burger{% endblock %}

{% block body %}
<div class="container">
    <div class="section">
        <h2 class="section-title">Mes Commandes</h2>
        
        {% if orders|length > 0 %}
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>N Commande</th>
                            <th>Date</th>
                            <th class="hide-mobile">Articles</th>
                            <th>Montant</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for order in orders %}
                        <tr>
                            <td><strong>#{{ order.id }}</strong></td>
                            <td>{{ order.createdAt|date('d/m/Y') }}</td>
                            <td class="hide-mobile">{{ order.items|length }} article(s)</td>
                            <td><strong>{{ order.total|number_format(0, ',', ' ') }} FCFA</strong></td>
                            <td>
                                {% set statusConfig = {
                                    'en_attente': 'badge-warning',
                                    'confirmee': 'badge-info',
                                    'en_preparation': 'badge-info',
                                    'en_livraison': 'badge-primary',
                                    'livree': 'badge-success',
                                    'annulee': 'badge-danger'
                                } %}
                                {% set badgeClass = statusConfig[order.statut] ?? 'badge-secondary' %}
                                <span class="badge {{ badgeClass }}">
                                    {{ order.statut|replace({'_': ' '})|capitalize }}
                                </span>
                            </td>
                            <td>
                                <a href="{{ path('app_order_show', {id: order.id}) }}" class="btn-edit">Details</a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div style="text-align: center; padding: 60px 20px;">
                <h3 style="color: #666; margin-bottom: 10px;">Aucune commande</h3>
                <p style="color: #888; margin-bottom: 30px;">Vous n'avez pas encore passe de commande.</p>
                <a href="{{ path('app_menu') }}" class="btn">Decouvrir notre carte</a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

