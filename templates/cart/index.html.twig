{% extends 'base.html.twig' %}

{% block title %}Panier - Brasil Burger{% endblock %}

{% block body %}
<div class="container">
    <div class="section">
        <h2 class="section-title">🛒 Votre Panier</h2>
        
        <div id="cart-content">
            <div id="cart-empty" style="text-align: center; padding: 60px 20px; display: none;">
                <div style="font-size: 4rem; margin-bottom: 20px;">🛒</div>
                <h3 style="color: #666; margin-bottom: 20px;">Votre panier est vide</h3>
                <a href="{{ path('app_menu') }}" class="btn">🍔 Voir notre carte</a>
            </div>
            
            <div id="cart-items">
                <table class="data-table" id="cart-table">
                    <thead>
                        <tr>
                            <th>Produit</th>
                            <th>Prix unitaire</th>
                            <th>Quantité</th>
                            <th>Total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="cart-body">
                        <!-- Dynamically filled -->
                    </tbody>
                </table>
                
                <div class="cart-summary" style="background: linear-gradient(135deg, #fff5eb 0%, #fff0e0 100%); padding: 30px; border-radius: 15px; margin-top: 30px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;">
                        <div>
                            <span style="font-size: 1.2rem; color: #666;">Total:</span>
                            <span id="cart-total" style="font-size: 2rem; font-weight: bold; color: var(--primary); margin-left: 10px;">0 FCFA</span>
                        </div>
                        <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                            <button class="btn btn-danger" onclick="clearCart()">🗑️ Vider le panier</button>
                            {% if app.user %}
                                <a href="{{ path('app_cart_checkout') }}" class="btn">✅ Commander</a>
                            {% else %}
                                <a href="{{ path('app_login') }}" class="btn">🔐 Se connecter pour commander</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function renderCart() {
    const cart = JSON.parse(localStorage.getItem('cart') || '[]');
    const tbody = document.getElementById('cart-body');
    const cartEmpty = document.getElementById('cart-empty');
    const cartItems = document.getElementById('cart-items');
    
    if (cart.length === 0) {
        cartEmpty.style.display = 'block';
        cartItems.style.display = 'none';
        return;
    }
    
    cartEmpty.style.display = 'none';
    cartItems.style.display = 'block';
    
    let html = '';
    let total = 0;
    
    cart.forEach((item, index) => {
        const itemTotal = item.prix * item.quantity;
        total += itemTotal;
        
        const typeIcon = item.type === 'burger' ? '🍔' : (item.type === 'menu' ? '🍽️' : '🍟');
        
        html += `
            <tr>
                <td>
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span style="font-size: 1.5rem;">${typeIcon}</span>
                        <div>
                            <strong>${item.nom}</strong>
                            <div style="font-size: 0.8rem; color: #888;">${item.type}</div>
                        </div>
                    </div>
                </td>
                <td>${item.prix.toLocaleString('fr-FR')} FCFA</td>
                <td>
                    <div style="display: flex; align-items: center; gap: 5px;">
                        <button class="btn btn-secondary btn-sm" onclick="updateQty(${index}, -1)" style="padding: 5px 10px;">-</button>
                        <span style="min-width: 30px; text-align: center;">${item.quantity}</span>
                        <button class="btn btn-secondary btn-sm" onclick="updateQty(${index}, 1)" style="padding: 5px 10px;">+</button>
                    </div>
                </td>
                <td><strong>${itemTotal.toLocaleString('fr-FR')} FCFA</strong></td>
                <td>
                    <button class="btn-delete" onclick="removeItem(${index})">🗑️</button>
                </td>
            </tr>
        `;
    });
    
    tbody.innerHTML = html;
    document.getElementById('cart-total').textContent = total.toLocaleString('fr-FR') + ' FCFA';
    updateCartCount();
}

function updateQty(index, delta) {
    let cart = JSON.parse(localStorage.getItem('cart') || '[]');
    cart[index].quantity += delta;
    if (cart[index].quantity < 1) cart[index].quantity = 1;
    localStorage.setItem('cart', JSON.stringify(cart));
    renderCart();
}

function removeItem(index) {
    let cart = JSON.parse(localStorage.getItem('cart') || '[]');
    cart.splice(index, 1);
    localStorage.setItem('cart', JSON.stringify(cart));
    renderCart();
}

function clearCart() {
    if (confirm('Êtes-vous sûr de vouloir vider votre panier ?')) {
        localStorage.removeItem('cart');
        renderCart();
    }
}

function updateCartCount() {
    let cart = JSON.parse(localStorage.getItem('cart') || '[]');
    let total = cart.reduce((sum, item) => sum + item.quantity, 0);
    const counter = document.querySelector('.cart-count');
    if (counter) {
        counter.textContent = total;
        counter.style.display = total > 0 ? 'inline' : 'none';
    }
}

document.addEventListener('DOMContentLoaded', renderCart);
</script>
{% endblock %}
